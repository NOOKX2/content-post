generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  DESIGNER
  ADMIN
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum MediaType {
  video
  image
}

enum ContentStatus {
  draft
  pending
  approved
  scheduled
  posting
  posted
  rejected
}

enum Platform {
  facebook
  instagram
  tiktok
  youtube
}

enum NotificationType {
  idea_deadline_reminder
  revision_needed
  approval_approved
  approval_rejected
  team_comment
  team_edit_request
  team_tag
  shoot_reminder
  post_status_update
  content_detail_changed
  monthly_summary
  task_assigned
  task_updated
}

enum CollaborationMessageType {
  text
  approval_request
  meeting
  system
}

model User {
  id              String                  @id @default(cuid())
  name            String
  email           String                  @unique
  password        String
  role            Role                    @default(USER)
  contents        Content[]
  notifications   Notification[]
  comments        ContentComment[]
  collabMessages  CollaborationMessage[]
  assignedTasks   Task[]                  @relation("TaskAssignee")
  createdTasks    Task[]                  @relation("TaskCreator")
  auditLogs       ContentAuditLog[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model CollaborationChannel {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  name      String
  contentId String?                @unique
  content   Content?               @relation(fields: [contentId], references: [id], onDelete: SetNull)
  messages  CollaborationMessage[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model CollaborationMessage {
  id          String                   @id @default(cuid())
  channelId   String
  channel     CollaborationChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?                    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  body        String                   @default("")
  messageType CollaborationMessageType @default(text)
  metadata    Json                     @default("{}")
  createdAt   DateTime                 @default(now())

  @@index([channelId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  contentId String?
  content   Content?         @relation(fields: [contentId], references: [id], onDelete: SetNull)
  link      String?
  readAt    DateTime?
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model ContentComment {
  id          String   @id @default(cuid())
  contentId   String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  commentType String   @default("comment")
  taggedName  String?
  createdAt   DateTime @default(now())

  @@index([contentId, createdAt])
}

model PostingChannel {
  id        String                   @id @default(cuid())
  slug      String                   @unique
  label     String
  prefix    String                   @unique
  sortOrder Int                      @default(0)
  enabled   Boolean                  @default(true)
  links     PostingChannelPlatform[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

model PostingChannelPlatform {
  id                String         @id @default(cuid())
  postingChannelId  String
  postingChannel    PostingChannel @relation(fields: [postingChannelId], references: [id], onDelete: Cascade)
  platform          Platform
  bufferChannelId   String
  bufferChannelName String         @default("")
  enabled           Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([postingChannelId, platform])
}

model Content {
  id             String        @id @default(cuid())
  contentId      String        @unique
  name           String
  mediaType      MediaType
  channel        String        @default("")
  platforms      Platform[]
  details        String        @default("")
  location       String[]
  scheduledDate     String
  scheduledTime     String
  endTime           String?
  ideaFinishedDate  String        @default("")
  shootDate         String        @default("")
  editFinishedDate  String        @default("")
  team           Json          @default("[]")
  productsNeeded String[]
  itemsToPrepare String        @default("")
  filmingEquipment String[]    @default([])
  attachments    String[]
  script         Json          @default("[]")
  ideaCreator    String        @default("")
  photographer   String        @default("")
  editor         String        @default("")
  approver       String?
  status         ContentStatus @default(pending)
  category       String        @default("")
  tags           String[]
  imageMeta      Json          @default("{}")
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  notifications  Notification[]
  comments       ContentComment[]
  tasks          Task[]
  auditLogs      ContentAuditLog[]
  collabChannel  CollaborationChannel?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, scheduledDate])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  status      TaskStatus @default(todo)
  dueDate     String     @default("")
  contentId   String?
  content     Content?   @relation(fields: [contentId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([contentId, createdAt])
}

model ContentAuditLog {
  id        String   @id @default(cuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String
  changes   Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([contentId, createdAt])
}
