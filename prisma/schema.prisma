generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MediaType {
  video
  image
}

enum ContentStatus {
  draft
  pending
  approved
  scheduled
  posted
  rejected
}

enum Platform {
  facebook
  instagram
  tiktok
  line
  lemon8
  youtube
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  contents  Content[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Content {
  id             String        @id @default(cuid())
  contentId      String        @unique
  name           String
  mediaType      MediaType
  channel        String        @default("")
  platforms      Platform[]
  details        String        @default("")
  location       String[]
  scheduledDate  String
  scheduledTime  String
  endTime        String?
  team           Json          @default("[]")
  productsNeeded String[]
  itemsToPrepare String        @default("")
  attachments    String[]
  script         Json          @default("[]")
  ideaCreator    String        @default("")
  photographer   String        @default("")
  editor         String        @default("")
  approver       String?
  status         ContentStatus @default(pending)
  category       String        @default("")
  tags           String[]
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, scheduledDate])
}
