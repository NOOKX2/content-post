generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MediaType {
  video
  image
}

enum ContentStatus {
  draft
  pending
  approved
  scheduled
  posted
  rejected
}

enum Platform {
  facebook
  instagram
  tiktok
  line
  lemon8
  youtube
}

enum NotificationType {
  idea_deadline_reminder
  revision_needed
  approval_approved
  approval_rejected
  team_comment
  team_edit_request
  team_tag
  shoot_reminder
  post_status_update
  content_detail_changed
  monthly_summary
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  password     String
  role         Role              @default(USER)
  contents     Content[]
  notifications Notification[]
  comments     ContentComment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  contentId String?
  content   Content?         @relation(fields: [contentId], references: [id], onDelete: SetNull)
  link      String?
  readAt    DateTime?
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model ContentComment {
  id          String   @id @default(cuid())
  contentId   String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  commentType String   @default("comment")
  taggedName  String?
  createdAt   DateTime @default(now())

  @@index([contentId, createdAt])
}

model Content {
  id             String        @id @default(cuid())
  contentId      String        @unique
  name           String
  mediaType      MediaType
  channel        String        @default("")
  platforms      Platform[]
  details        String        @default("")
  location       String[]
  scheduledDate  String
  scheduledTime  String
  endTime        String?
  team           Json          @default("[]")
  productsNeeded String[]
  itemsToPrepare String        @default("")
  filmingEquipment String[]    @default([])
  attachments    String[]
  script         Json          @default("[]")
  ideaCreator    String        @default("")
  photographer   String        @default("")
  editor         String        @default("")
  approver       String?
  status         ContentStatus @default(pending)
  category       String        @default("")
  tags           String[]
  imageMeta      Json          @default("{}")
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  notifications  Notification[]
  comments       ContentComment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, scheduledDate])
}
